# Matikan Directory Browsing (Mencegah publik mengintip daftar file di browser)
Options -Indexes

# Proteksi file tersembunyi seperti .git, .gitignore
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Standar Karakter UTF-8
AddDefaultCharset UTF-8
